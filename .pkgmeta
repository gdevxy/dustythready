# Read by CurseForge's packager (and the BigWigs packager in .github/workflows/release.yml).
# The zip contains one "DustyThready" folder with the addon; everything below is left out.
package-as: DustyThready

ignore:
  - docs
  - tools
  - dist
  - promo
  - README.md
  - CLAUDE.md
  - Media/icon-source.jpg

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
